# Stage 4: Attendance + Presence Monitoring Engine Environment Variables

# App & Server Settings
APP_NAME="AI Classroom Attendance & Presence Monitoring Engine"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
DATABASE_URL="sqlite:///./attendance.db"

# 1. Late Entry Configuration (Minutes)
LATE_THRESHOLD_MINUTES=5

# 2. Continuous Presence Verification
VERIFICATION_INTERVAL_MINUTES=10
ABSENCE_CONFIRMATION_INTERVALS=3

# 3. Recognition Deduplication (Seconds)
RECOGNITION_DEDUPLICATION_SECONDS=30

# 4. Face Recognition Confidence Threshold (0.00 - 1.00)
CONFIDENCE_THRESHOLD=0.80

# 5. Camera Health Monitoring (Seconds)
CAMERA_TIMEOUT_SECONDS=60

# 6. Attendance Percentage Classification Thresholds (%)
ATTENDANCE_GOOD_THRESHOLD=75.0
ATTENDANCE_WARNING_THRESHOLD=65.0
DEFAULT_WORKING_DAYS=80
