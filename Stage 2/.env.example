# Copy this file to `.env` and adjust values for the local environment.
# No real secrets are stored here — this is only a template.

# Name and version shown by the FastAPI application metadata.
APP_NAME=AI College Attendance Management System
APP_VERSION=1.0.0

# Database connection string.
#
# Development default (SQLite):
DATABASE_URL=sqlite:///./attendance.db
#
# PostgreSQL example (uncomment and use the appropriate driver):
# DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/attendance_db

# --- JWT authentication ---
# The values below are placeholders. Set a strong random secret in your
# real environment — never commit a production secret to source control.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30